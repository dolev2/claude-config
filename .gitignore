# This repo is ~/.claude, which also holds credentials, session transcripts and every
# project's memory. So everything is ignored, and only what is listed here is tracked:
# a new file stays out until it is added to this list.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/ruff.toml
!/CLAUDE.md
!/.github/
!/skills/
# What a cloud session's service puts inside skills/ (claude-config#132).
/skills/synced/
/skills/session-start-hook/
!/rules/
!/docs/
!/settings.json
!/hooks/

# Only the repo's own instructions; Claude Code also keeps worktrees and local settings here.
!/.claude/
/.claude/*
!/.claude/CLAUDE.md

__pycache__/
*.pyc
.pytest_cache/
