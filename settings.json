{
  "env": {
    "PYTHONIOENCODING": "utf-8"
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "autoCompactWindow": 400000
    }
  },
  "permissions": {
    "ask": [
      "Bash(gh pr merge)",
      "Bash(gh pr merge *)",
      "PowerShell(gh pr merge)",
      "PowerShell(gh pr merge *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v python3 || command -v python)\" \"$HOME/.claude/hooks/block_force_push.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$(command -v python3 || command -v python)\" \"$HOME/.claude/hooks/guard_main_folder.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v python3 || command -v python)\" \"$HOME/.claude/hooks/guard_main_folder.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$(command -v python3 || command -v python)\" \"$HOME/.claude/hooks/guard_parallel_parts.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v python3 || command -v python)\" \"$HOME/.claude/hooks/ps1_bom.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$(command -v python3 || command -v python)\" \"$HOME/.claude/hooks/ruff_on_edit.py\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
