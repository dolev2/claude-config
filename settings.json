{
  "modelSettings": {
    "claude-opus-5-5": {
      "autoCompactWindow": 400000
    }
  },
  "permissions": {
    "ask": [
      "Bash(gh pr merge)",
      "Bash(gh pr merge *)",
      "PowerShell(gh pr merge)",
      "PowerShell(gh pr merge *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v python3 || command -v python)\" \"$HOME/.claude/hooks/block_force_push.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
