{
  "env": {
    "PYTHONIOENCODING": "utf-8"
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "autoCompactWindow": 400000
    }
  },
  "permissions": {
    "allow": [
      "mcp__github__get_me",
      "mcp__github__issue_read",
      "mcp__github__pull_request_read",
      "mcp__github__list_issues",
      "mcp__github__list_pull_requests",
      "mcp__github__list_branches",
      "mcp__github__list_commits",
      "mcp__github__get_commit",
      "mcp__github__get_file_contents",
      "mcp__github__get_label",
      "mcp__github__get_check_run",
      "mcp__github__get_job_logs",
      "mcp__github__actions_get",
      "mcp__github__actions_list",
      "mcp__claude-code-remote__get_session",
      "mcp__claude-code-remote__list_sessions",
      "mcp__claude-code-remote__list_events",
      "mcp__claude-code-remote__get_event",
      "mcp__claude-code-remote__get_environment",
      "mcp__claude-code-remote__read_documentation",
      "mcp__claude-code-remote__list_triggers",
      "mcp__claude-code-remote__get_trigger",
      "mcp__claude-code-remote__set_session_title",
      "mcp__claude-code-remote__subscribe_pr_activity",
      "mcp__claude-code-remote__unsubscribe_pr_activity",
      "mcp__github__create_pull_request",
      "mcp__github__update_pull_request",
      "mcp__github__add_issue_comment",
      "mcp__claude-code-remote__send_message"
    ],
    "ask": [
      "Bash(gh pr merge)",
      "Bash(gh pr merge *)",
      "PowerShell(gh pr merge)",
      "PowerShell(gh pr merge *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v python3 || command -v python)\" \"$HOME/.claude/hooks/cloud_refresh.py\"",
            "timeout": 60
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v python3 || command -v python)\" \"$HOME/.claude/hooks/ask_before_merge.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$(command -v python3 || command -v python)\" \"$HOME/.claude/hooks/block_force_push.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$(command -v python3 || command -v python)\" \"$HOME/.claude/hooks/block_merge_subject.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$(command -v python3 || command -v python)\" \"$HOME/.claude/hooks/guard_main_folder.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__.*__(merge_pull_request|enable_pr_auto_merge)",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v python3 || command -v python)\" \"$HOME/.claude/hooks/ask_before_merge.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$(command -v python3 || command -v python)\" \"$HOME/.claude/hooks/block_merge_subject.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__.*__create_session",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v python3 || command -v python)\" \"$HOME/.claude/hooks/guard_create_session.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v python3 || command -v python)\" \"$HOME/.claude/hooks/guard_main_folder.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$(command -v python3 || command -v python)\" \"$HOME/.claude/hooks/guard_parallel_parts.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v python3 || command -v python)\" \"$HOME/.claude/hooks/ps1_bom.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$(command -v python3 || command -v python)\" \"$HOME/.claude/hooks/ruff_on_edit.py\"",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "outputStyle": "Learning"
}
